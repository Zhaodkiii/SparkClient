/* ToolPrompts — 简体中文（发给模型的文案） */
/* 键名：稳定英文 tool.*，与 ToolHub.swift 中 td("…") 一致；勿改键名，仅改右侧中文。 */
/* 维护：新增工具时在 en / zh-Hans / zh-Hant 三份中同步增加相同键。 */

/* ========== 工具 function 摘要（发给模型） ========== */
"tool.summary.fetch_step_details" = "用途：按小时检索步数并汇总每日及总计。触发场景：用户回顾活动量、制定健身计划。输入要求：start_date、end_date ≤ 今天，格式 yyyy‑MM‑dd。输出单位：步。可与 fetch_energy_details 联用，用于综合活动度分析。";
"tool.summary.fetch_energy_details" = "用途：按小时统计静息/活动/总能量 (kcal)。触发场景：用户评估热量消耗。输入要求与步数相同。可与 fetch_step_details、fetch_nutrition_details 联用，实现消耗‑摄入对比。";
"tool.summary.fetch_nutrition_details" = "用途：以 3 小时粒度统计蛋白质、碳水、脂肪、能量摄入 (g/kcal)。触发场景：用户审视饮食结构或准备饮食计划。输入日期规则同上。可与 make_nutrition_data 联用，用于生成健康卡片。";
"tool.summary.make_nutrition_data" = "用途：根据用户提供或模型解析的饮食信息生成营养卡片；字段值需为非负 (g/kcal)。触发场景：记录或分析一次具体饮食或用户提到营养卡片。可与 fetch_nutrition_details 联用，校正和补全数据。";
"tool.summary.show_medical_risk_notice" = "用途：在涉及医疗/健康风险时插入结构化风险提示卡片。触发场景：解读检查/用药/症状、给出治疗或用药建议、涉及慢病/孕期/儿童/老人等敏感健康建议、或出现急症相关描述。参数 risk_level 必填；message 建议填写具体提醒。";
"tool.summary.fetch_sleep_details" = "用途：按会话和日汇总检索睡眠数据（核心/深度/REM/未指定睡眠阶段）。触发场景：用户回顾睡眠质量、分析睡眠模式、制定睡眠计划。输入要求：start_date、end_date ≤ 今天，格式 yyyy‑MM‑dd。可与 fetch_step_details、fetch_energy_details 联用。";
"tool.summary.fetch_workout_details" = "用途：检索运动记录（跑步、步行、骑行等）。输入：start_date、end_date；可选 types 筛选活动类型；max_items 限制返回条数。可与 fetch_step_details、fetch_energy_details 联用。";
"tool.summary.generate_structured_health_card" = "用途：生成可保存的结构化健康卡片（后台 AI 抽取）。调用时 report_type 指定卡片类型，raw_text 必须是你提炼后的关键摘录（勿传完整 OCR）。可选 oss_file_id（整数）。";
"tool.summary.query_tasks_by_member" = "用途：按成员维度查询已有任务（主任务+子任务状态），用于任务生成前去重分析。member_id 可选，默认当前主页成员。调用规则：在 generate_task 前必须先调用。输出必须是结构化 JSON。";
"tool.summary.generate_task" = "用途：基于用户输入生成“待确认任务卡片 JSON”，并执行异步任务抽取与相似任务分析。member_id 可选，默认当前主页成员。调用规则：必须先调用 query_tasks_by_member；若存在相似任务则返回不创建说明 JSON；否则返回 task_cards JSON。";
"tool.summary.search_knowledge_bag" = "用途：检索本地知识背包并返回摘要。触发场景：问题与个人笔记/文档相关。输入要求：query 精准描述主题。优先使用本工具，再考虑 search_online。可与 retrieve_memory 联用。";
"tool.summary.create_knowledge_document" = "用途：当输出为总结/调研内容或用户要求创建知识文档时，先生成可预览的知识卡草稿（不直接落库）。title 简短关键；content 使用 Markdown，层次清晰；最终由用户点击保存到知识库。";
"tool.summary.search_calendar_and_reminders" = "用途：筛选系统日历事件与提醒事项。至少需提供关键词、日期范围或地点之一。日期 yyyy‑MM‑dd，本地时区。若所有过滤条件为空，不应调用。可与 get_current_location 联用。";
"tool.summary.write_system_event" = "用途：向系统写入日历或提醒。时间字段必须为 ISO‑8601 且包含时区；type=calendar 需 start_date 与 end_date；type=reminder 需 due_date。提醒地点放入 notes。可与 search_calendar_and_reminders 联用。";
"tool.summary.query_location" = "用途：根据地名返回坐标 (WGS‑84) 并绘制静态地图缩略图。keyword 为具体地名或 POI。可与 search_nearby_locations、get_current_location 联用。";
"tool.summary.get_current_location" = "用途：获取当前用户所在位置。用户问「我在哪？」或需要基于当前位置搜索周边、规划路线、查询天气时使用。query 固定值「local」。可与 search_nearby_locations、get_route、query_weather 联用。";
"tool.summary.search_nearby_locations" = "用途：按中心坐标+关键词搜索周边兴趣点。coordinate 必含 latitude 与 longitude；keyword 如「咖啡馆」。可与 query_location 联用。";
"tool.summary.get_route" = "用途：规划驾驶/步行/公共交通路线。输入 start、end 坐标与 mode (driving|walking|transit)。可与 query_location、get_current_location 联用。";
"tool.summary.query_weather" = "用途：查询指定坐标的天气，支持实时(now)和多日预报(3d、7d、10d、15d、30d)。输入 latitude、longitude、timeRange。可先调用 query_location 或 get_current_location。";
"tool.summary.save_memory" = "用途：将信息写入长期记忆。content 简洁完整，最好为主谓宾句式。避免重复保存。可与 retrieve_memory 联用。";
"tool.summary.retrieve_memory" = "用途：检索长期记忆。keyword 支持分号分隔多个关键词。仅在确实需要时调用。可与 save_memory 联用。";
"tool.summary.update_memory" = "用途：修改已存的长期记忆。originalContent 为原始全文，updatedContent 为新内容；仅完全匹配条目。应与 retrieve_memory 联用，先检索再更新。";
"tool.summary.generate_chat_title" = "用途：根据当前对话生成简洁标题（≤6 字，可含 emoji）。会话标题仍为默认且用户已发消息时可调用。无必选参数。";
"tool.summary.show_custom_message_card" = "用途：在助手回复内展示拍照/上传卡片，引导用户提交图片。典型场景：需解读报告/药盒/皮肤但尚无附件。";
"tool.summary.get_current_member" = "用途：读取当前可用成员（全局已选成员、本会话 thread 绑定成员或参数 member_id）。返回姓名、关系与 member_id。若 list_member_health_sources / get_health_resource_context 的 JSON 已含 member_id，以该值为准，勿因本工具曾返回「未选择」而重复选成员。";
"tool.summary.request_member_selection" = "用途：仅当无法从 get_current_member、list JSON、thread 绑定或参数解析出 member_id 时再调用。若 member_id 已明确，客户端会短路返回（不弹窗）。list/健康资料工具之后禁止再调用本工具。";
"tool.summary.switch_member" = "用途：切换当前成员；选择后后续 query_member_profile 等使用新成员（Spark 本地为占位说明）。";
"tool.summary.find_member" = "用途：通过关系或姓名查找成员（name/relationship 至少其一）。禁止把 member_id 数字当作 name（如 name=\"19\"）。list_member_health_sources 或健康工具 JSON 已含 member_id 时勿调用本工具。";
"tool.summary.query_member_profile" = "用途：查询成员健康信息摘要。query_type：summary / medications / hospital_exams / medical_records / health_exams。可选 member_id（Spark 为成员 UUID 字符串）；可选 days、limit。Spark 当前返回各类型记录数量汇总。";
"tool.summary.list_member_health_sources" = "用途：从成员 complete-data 快照检索可引用的健康资料（体检、检查/影像报告、病历、用药、症状、就诊等）。用户口头问某份报告/记录且未手动点「问报告」时使用。输入：可选 member_id（默认会话成员）、resource_types（推荐，可多类型）或 resource_type（单类型兼容）、keyword、日期范围、limit。输出：JSON 含 member_id 与候选列表，不含全文。规则：(1) 输出中的 member_id 即本轮成员，之后勿 request_member_selection / find_member；(2) 仅一条候选时不弹窗；(3) 多条时客户端弹报告候选确认；(4) 确定资料后**一次** get_health_resource_context（references 含全部 resource_type+resource_id）。仅要数量汇总时用 query_member_profile。";
"tool.summary.get_health_resource_reference" = "用途：仅在校验引用是否存在且尚无 resource_id 时使用（返回紧凑 JSON + 客户端展示卡片）。list 已返回候选或用户已确认后，解读请直接 get_health_resource_context，勿与本工具重复调用同一 resource。";
"tool.summary.get_health_resource_context" = "用途：构建 AI 可读解读上下文（与客户端 M8 同 schema）。**优先批量**：将 list/用户确认后的多条资料组成 references JSON，一次调用返回 version=2（contexts + combined_context_text）；仅一条时可用 resource_type+resource_id（version=1）。对比多份报告/记录时必须用 references 批量调用，禁止对每条 resource 重复调用。勿再调 get_health_resource_reference。勿持久化到消息库。";
"tool.param.health_resource_type_enum" = "健康资料类型：health_exam_report、examination_report、medical_case、prescription、medication_plan、medicine_box、medication_record、medication_summary、symptom、visit、surgery、follow_up";
"tool.param.health_resource_types_filter" = "可选，健康资料类型筛选（数组）。可同时传多种，如 [\"health_exam_report\",\"examination_report\"] 或逗号分隔；与 resource_type 二选一或合并；空则全部类型。";
"tool.param.health_resource_id" = "complete-data 中该资料主键 ID";
"tool.param.health_keyword" = "在标题、检查名、摘要、所见/结论等字段中搜索的关键词";
"tool.param.health_sources_limit" = "返回候选条数上限（默认 20）";
"tool.param.health_topic_focus" = "可选解读聚焦主题，用于上下文裁剪，如 blood_pressure、thyroid";
"tool.param.health_references_json" = "批量解读：JSON 数组，每项含 resource_type、resource_id、member_id（可省略，默认会话成员）。与 list/用户确认后的 candidates 对齐，最多 5 条。传入后勿再逐条调用本工具；单条时仍可用 resource_type+resource_id。";
"tool.summary.search_online" = "用途：在线检索并汇总多来源信息。query 简洁；勿含个人敏感信息。可与 read_web_page、search_knowledge_bag 联用。";
"tool.summary.read_web_page" = "用途：抓取网页正文并生成摘要。url 须为完整 HTTP(S)。同一链接解析一次。";
"tool.summary.search_arxiv_papers" = "用途：检索 arXiv 学术文献并生成摘要。query 为主题相关英文关键词。";
"tool.summary.extract_remote_file_content" = "用途：从在线 PDF/Office/文本等文件提取纯文本。url 为完整 HTTP(S) 文件链接。";
"tool.summary.create_canvas" = "用途：长文本、大段代码或 HTML 等不适合气泡展示时创建画布；支持 Markdown/代码/HTML。需 title、content、type (text|python|html)。";
"tool.summary.edit_canvas" = "用途：用正则 patterns 与 replacements 一一对应修改已有画布正文；标题与内容在客户端分开存储时需分别处理。改动多时可新建画布覆盖。";
"tool.summary.generic" = "执行 %@ 工具。";
