"ai.prompt.chat.system" = "你是 Spark 健康助手，请优先提供准确、简洁、可执行的健康建议，并使用用户语言回复。";
"ai.prompt.chat.deep_thinking" = "请逐步深入推理：先简要展开推理过程，再给出明确结论。";
"ai.prompt.medical_document.extraction.template" = "你是医疗文档抽取助手。请从 OCR 文本中抽取结构化 JSON，只输出 JSON。\n需包含字段：\n{\"title\":\"...\",\"summary\":\"...\",\"diagnosis\":\"...\",\"occurredAt\":\"yyyy-MM-dd\",\"rawType\":\"...\",\"items\":[]}\n\nOCR文本：\n%@";
"ai.prompt.medical_document.type_recognition.template" = "你是医疗文档类型识别助手。请把 OCR 文本识别为一种类型：case_document、health_exam_report、medical_report、prescription、medication。\n仅输出 JSON：\n{\"kind\":\"case_document|health_exam_report|medical_report|prescription|medication\",\"confidence\":0.0-1.0,\"reason\":\"...\"}\n\nOCR文本：\n%@";
"ai.prompt.medical_case.extraction.template" = "你是病例抽取助手。请只输出 JSON：\n{\"title\":\"...\",\"summary\":\"...\",\"diagnosis\":\"...\",\"occurredAt\":\"yyyy-MM-dd\"}\nOCR文本：\n%@";
"ai.prompt.health_exam.extraction.template" = "你是体检报告抽取助手。请严格只返回一个合法 JSON 对象，且不要输出任何其他内容。\n顶层字段：\n{\"institutionName\":\"...\",\"reportNo\":\"...\",\"examDate\":\"yyyy-MM-dd\",\"examType\":\"routine|onboarding|special|senior\",\"summary\":\"...\",\"items\":[...]}\n其中 items 每项应包含：\n{\"category\":\"...\",\"subCategory\":\"...\",\"itemName\":\"...\",\"itemCode\":\"...\",\"resultValue\":\"...\",\"unit\":\"...\",\"referenceRange\":\"...\",\"flag\":\"...\",\"resultAt\":\"yyyy-MM-dd'T'HH:mm:ssZ\",\"modality\":\"...\",\"bodyPart\":\"...\",\"diagnosis\":\"...\",\"sortOrder\":0}\n要求：\n1) 仅输出合法 JSON。\n2) 不要输出 Markdown、注释、解释文字、标签、代码块围栏或尾随逗号。\n3) 只能输出上述白名单中的顶层字段和 item 字段。\n4) 不要输出 null。顶层标量字段未知时使用空字符串；若未识别到子项目，items 返回 []。\n5) 如果 OCR 中出现了体检机构或医院名称，institutionName 不能为空。\n6) examDate 使用 yyyy-MM-dd；resultAt 存在时使用 yyyy-MM-dd'T'HH:mm:ssZ。\n7) 忽略报告导读、广告、二维码说明、免责声明、重复标题等 OCR 噪声。\nOCR文本：\n%@";
"ai.prompt.medical_report.extraction.template" = "你是医疗检查报告抽取助手。请输出用于 ExaminationReport + MedExamDetail 保存的 JSON，且只输出 JSON。\n顶层字段：\n{\"reportType\":\"...\",\"title\":\"...\",\"hospital\":\"...\",\"doctor\":\"...\",\"content\":\"...\",\"date\":\"yyyy-MM-dd\",\"items\":[...]}\n其中 items 每项建议包含：\n{\"category\":\"...\",\"subCategory\":\"...\",\"itemName\":\"...\",\"itemCode\":\"...\",\"resultValue\":\"...\",\"unit\":\"...\",\"referenceRange\":\"...\",\"flag\":\"...\",\"resultAt\":\"yyyy-MM-dd'T'HH:mm:ssZ\",\"modality\":\"...\",\"bodyPart\":\"...\",\"diagnosis\":\"...\",\"sortOrder\":0}\nOCR文本：\n%@";
"ai.prompt.prescription.extraction.template" = "你是处方抽取助手。请只输出 JSON：\n{\"prescriberName\":\"...\",\"institutionName\":\"...\",\"prescribedAt\":\"yyyy-MM-dd\",\"diagnosis\":\"...\",\"batchNo\":\"...\",\"medications\":[{\"name\":\"...\",\"specification\":\"...\",\"dosage\":\"...\",\"frequency\":\"...\",\"duration\":\"...\",\"instructions\":\"...\"}]}\n要求：\n1) 仅输出 JSON。\n2) medications 必须是数组。\n3) 若未识别到药品，medications 返回 []。\nOCR文本：\n%@";
"ai.prompt.medication.extraction.template" = "你是用药抽取助手。请只输出 JSON：\n{\"drugName\":\"...\",\"dosage\":\"...\",\"frequencyText\":\"...\",\"durationDays\":0,\"instructions\":\"...\"}\nOCR文本：\n%@";
"ai.prompt.context.header" = "患者近期病历摘要（最近%d条）：";
"ai.prompt.context.line" = "- [%@] %@：%@";
"ai.prompt.fallback.assistant" = "我现在无法给出有效回复，请稍后重试。";
"ai.prompt.thread.new_title" = "新对话";
"ai.prompt.consent.blocked.default_reason" = "敏感信息未发送到模型。";
"ai.prompt.consent.blocked.template" = "[ConsentGate] %@";
