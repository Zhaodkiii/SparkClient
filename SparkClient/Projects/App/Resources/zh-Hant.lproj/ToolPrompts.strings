/* ToolPrompts — 繁體中文（發給模型的文案；由簡體轉換後可再人工潤飾） */
/* 鍵名：穩定英文 tool.*，與 ToolHub.swift 中 td("…") 一致；勿改鍵名，僅改右側繁體。 */
/* 維護：新增工具時在 en / zh-Hans / zh-Hant 三份中同步增加相同鍵。 */

/* ========== 工具 function 摘要（发给模型） ========== */
"tool.summary.fetch_step_details" = "用途：按小時檢索步數並彙總每日及總計。觸發場景：使用者回顧活動量、制定健身計劃。輸入要求：start_date、end_date ≤ 今天，格式 yyyy‑MM‑dd。輸出單位：步。可與 fetch_energy_details 聯用，用於綜合活動度分析。";
"tool.summary.fetch_energy_details" = "用途：按小時統計靜息/活動/總能量 (kcal)。觸發場景：使用者評估熱量消耗。輸入要求與步數相同。可與 fetch_step_details、fetch_nutrition_details 聯用，實現消耗‑攝入對比。";
"tool.summary.fetch_nutrition_details" = "用途：以 3 小時粒度統計蛋白質、碳水、脂肪、能量攝入 (g/kcal)。觸發場景：使用者審視飲食結構或準備飲食計劃。輸入日期規則同上。可與 make_nutrition_data 聯用，用於生成健康卡片。";
"tool.summary.make_nutrition_data" = "用途：根據使用者提供或模型解析的飲食資訊生成營養卡片；欄位值需為非負 (g/kcal)。觸發場景：記錄或分析一次具體飲食或使用者提到營養卡片。可與 fetch_nutrition_details 聯用，校正和補全資料。";
"tool.summary.fetch_sleep_details" = "用途：按會話和日彙總檢索睡眠資料（核心/深度/REM/未指定睡眠階段）。觸發場景：使用者回顧睡眠質量、分析睡眠模式、制定睡眠計劃。輸入要求：start_date、end_date ≤ 今天，格式 yyyy‑MM‑dd。可與 fetch_step_details、fetch_energy_details 聯用。";
"tool.summary.fetch_workout_details" = "用途：檢索運動記錄（跑步、步行、騎行等）。輸入：start_date、end_date；可選 types 篩選活動型別；max_items 限制返回條數。可與 fetch_step_details、fetch_energy_details 聯用。";
"tool.summary.generate_structured_health_card" = "用途：生成可儲存的結構化健康卡片（後臺 AI 抽取）。呼叫時 report_type 指定卡片型別，raw_text 必須是你提煉後的關鍵摘錄（勿傳完整 OCR）。可選 oss_file_id（整數）。Spark 端為佔位實現。";
"tool.summary.query_tasks_by_member" = "用途：按成員維度查詢既有任務（主任務+子任務狀態），用於任務生成前去重分析。member_id 可選，預設當前首頁成員。呼叫規則：在 generate_task 前必須先呼叫。輸出必須是結構化 JSON。";
"tool.summary.generate_task" = "用途：根據使用者輸入生成「待確認任務卡片 JSON」，並執行異步任務抽取與相似任務分析。member_id 可選，預設當前首頁成員。呼叫規則：必須先呼叫 query_tasks_by_member；若存在相似任務則返回不建立說明 JSON；否則返回 task_cards JSON。";
"tool.summary.search_knowledge_bag" = "用途：檢索本地知識揹包並返回摘要。觸發場景：問題與個人筆記/文件相關。輸入要求：query 精準描述主題。優先使用本工具，再考慮 search_online。可與 retrieve_memory 聯用。";
"tool.summary.create_knowledge_document" = "用途：當輸出為總結/調研內容或使用者要求建立知識文件時，先生成可預覽的知識卡草稿（不直接落庫）。title 簡短關鍵；content 使用 Markdown，層次清晰；最終由使用者點擊保存到知識庫。";
"tool.summary.search_calendar_and_reminders" = "用途：篩選系統日曆事件與提醒事項。至少需提供關鍵詞、日期範圍或地點之一。日期 yyyy‑MM‑dd，本地時區。若所有過濾條件為空，不應呼叫。可與 get_current_location 聯用。";
"tool.summary.write_system_event" = "用途：向系統寫入日曆或提醒。時間欄位必須為 ISO‑8601 且包含時區；type=calendar 需 start_date 與 end_date；type=reminder 需 due_date。提醒地點放入 notes。可與 search_calendar_and_reminders 聯用。";
"tool.summary.query_location" = "用途：根據地名返回座標 (WGS‑84) 並繪製靜態地圖縮圖。keyword 為具體地名或 POI。可與 search_nearby_locations、get_current_location 聯用。";
"tool.summary.get_current_location" = "用途：獲取當前使用者所在位置。使用者問「我在哪？」或需要基於當前位置搜尋周邊、規劃路線、查詢天氣時使用。query 固定值「local」。可與 search_nearby_locations、get_route、query_weather 聯用。";
"tool.summary.search_nearby_locations" = "用途：按中心座標+關鍵詞搜尋周邊興趣點。coordinate 必含 latitude 與 longitude；keyword 如「咖啡館」。可與 query_location 聯用。";
"tool.summary.get_route" = "用途：規劃駕駛/步行/公共交通路線。輸入 start、end 座標與 mode (driving|walking|transit)。可與 query_location、get_current_location 聯用。";
"tool.summary.query_weather" = "用途：查詢指定座標的天氣，支援實時(now)和多日預報(3d、7d、10d、15d、30d)。輸入 latitude、longitude、timeRange。可先呼叫 query_location 或 get_current_location。";
"tool.summary.save_memory" = "用途：將資訊寫入長期記憶。content 簡潔完整，最好為主謂賓句式。避免重複儲存。可與 retrieve_memory 聯用。";
"tool.summary.retrieve_memory" = "用途：檢索長期記憶。keyword 支援分號分隔多個關鍵詞。僅在確實需要時呼叫。可與 save_memory 聯用。";
"tool.summary.update_memory" = "用途：修改已存的長期記憶。originalContent 為原始全文，updatedContent 為新內容；僅完全匹配條目。應與 retrieve_memory 聯用，先檢索再更新。";
"tool.summary.generate_chat_title" = "用途：根據當前對話生成簡潔標題（≤6 字，可含 emoji）。會話標題仍為預設且使用者已發訊息時可呼叫。無必選引數。";
"tool.summary.show_custom_message_card" = "用途：在助手回覆內展示拍照/上傳卡片，引導使用者提交圖片。典型場景：需解讀報告/藥盒/皮膚但尚無附件。";
"tool.summary.get_current_member" = "用途：讀取當前已選成員基本資訊。若未選擇成員，客戶端可引導選擇（Spark 本地返回提示）。";
"tool.summary.switch_member" = "用途：切換當前成員；選擇後後續 query_member_profile 等使用新成員（Spark 本地為佔位說明）。";
"tool.summary.find_member" = "用途：透過關係或姓名查詢成員。可提供 name 與/或 relationship（部分匹配）。至少提供其一。";
"tool.summary.query_member_profile" = "用途：查詢成員健康資訊摘要。query_type：summary / medications / hospital_exams / medical_records / health_exams。可選 member_id（Spark 為成員 UUID 字串）；可選 days、limit。Spark 當前返回各型別記錄數量彙總。";
"tool.summary.search_online" = "用途：線上檢索並彙總多來源資訊。query 簡潔；勿含個人敏感資訊。可與 read_web_page、search_knowledge_bag 聯用。";
"tool.summary.read_web_page" = "用途：抓取網頁正文並生成摘要。url 須為完整 HTTP(S)。同一連結解析一次。";
"tool.summary.search_arxiv_papers" = "用途：檢索 arXiv 學術文獻並生成摘要。query 為主題相關英文關鍵詞。";
"tool.summary.extract_remote_file_content" = "用途：從線上 PDF/Office/文字等檔案提取純文字。url 為完整 HTTP(S) 檔案連結。";
"tool.summary.create_canvas" = "用途：長文字、大段程式碼或 HTML 等不適合氣泡展示時建立畫布；支援 Markdown/程式碼/HTML。需 title、content、type (text|python|html)。";
"tool.summary.edit_canvas" = "用途：用正則 patterns 與 replacements 一一對應修改已有畫布正文；標題與內容在客戶端分開儲存時需分別處理。改動多時可新建畫布覆蓋。";
"tool.summary.generic" = "執行 %@ 工具。";
