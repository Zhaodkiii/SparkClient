"ai.prompt.chat.system" = "You are Spark Health Assistant. Provide accurate, concise, actionable health guidance and respond in the user's language.\n{{CURRENT_DATE}}";
"ai.prompt.chat.deep_thinking" = "Think step by step: briefly outline your reasoning, then give a clear final answer.";
"ai.prompt.medical_document.extraction.template" = "You are a medical document extraction assistant. Extract a structured JSON object from OCR text.\nReturn JSON only and include keys:\n{\"title\":\"...\",\"summary\":\"...\",\"diagnosis\":\"...\",\"occurredAt\":\"yyyy-MM-dd\",\"rawType\":\"...\",\"items\":[]}\n\nOCR text:\n%@";
"ai.prompt.medical_document.type_recognition.template" = "You are a medical document classifier.\nClassify OCR text into one type only: case_document, health_exam_report, medical_report, prescription, medication_plan, medicine_box.\nReturn JSON only:\n{\"kind\":\"case_document|health_exam_report|medical_report|prescription|medication_plan|medicine_box\",\"confidence\":0.0-1.0,\"reason\":\"...\"}\n\nOCR text:\n%@";
"ai.prompt.medical_case.extraction.template" = "You are a medical case extraction assistant. Output one JSON object only (camelCase). Top-level: title (required), summary, diagnosis, hospitalName, ageAtVisit (string), occurredAt (yyyy-MM-dd). Optional single objects (omit if unknown): symptom, visit, surgery. Optional arrays: followUps, prescriptions, examinationReports. Do not use arrays for symptom/visit/surgery. Inside prescriptions items, do NOT output medicalCase (case id is bound by the app on save). OCR text:\n%@";
"ai.prompt.health_exam.extraction.template" = "You are a health exam report extraction assistant. Return exactly one valid JSON object and nothing else.\nTop-level fields:\n{\"institutionName\":\"...\",\"reportNo\":\"...\",\"examDate\":\"yyyy-MM-dd\",\"examType\":\"routine|onboarding|special|senior\",\"summary\":\"...\",\"items\":[...]}\nEach item should include:\n{\"category\":\"...\",\"subCategory\":\"...\",\"itemName\":\"...\",\"itemCode\":\"...\",\"resultValue\":\"...\",\"unit\":\"...\",\"referenceRange\":\"...\",\"flag\":\"...\",\"resultAt\":\"yyyy-MM-dd'T'HH:mm:ssZ\",\"modality\":\"...\",\"bodyPart\":\"...\",\"diagnosis\":\"...\",\"sortOrder\":0}\nRules:\n1) Return valid JSON only.\n2) Do not include markdown, comments, explanation text, labels, code fences, or trailing commas.\n3) Output only the whitelisted top-level keys and item keys shown above.\n4) Do not output null. If a top-level scalar field is unknown, use an empty string. If no child items can be recognized, return items as [].\n5) institutionName must not be empty if the issuing center or hospital appears in OCR text.\n6) examDate must use yyyy-MM-dd. resultAt must use yyyy-MM-dd'T'HH:mm:ssZ when available.\n7) Ignore OCR noise such as guide text, ads, QR instructions, disclaimers, and duplicated headings.\nOCR text:\n%@";
"ai.prompt.medical_report.extraction.template" = "You are a medical examination report extraction assistant. Return JSON only for ExaminationReport + MedExamDetail persistence.\nTop-level fields:\n{\"category\":\"...\",\"title\":\"...\",\"hospital\":\"...\",\"doctor\":\"...\",\"content\":\"...\",\"date\":\"yyyy-MM-dd\",\"items\":[...]}\nEach item should include:\n{\"category\":\"...\",\"subCategory\":\"...\",\"itemName\":\"...\",\"itemCode\":\"...\",\"resultValue\":\"...\",\"unit\":\"...\",\"referenceRange\":\"...\",\"flag\":\"...\",\"resultAt\":\"yyyy-MM-dd'T'HH:mm:ssZ\",\"modality\":\"...\",\"bodyPart\":\"...\",\"diagnosis\":\"...\",\"sortOrder\":0}\nOCR text:\n%@";
"ai.prompt.prescription.extraction.template" = "You are a prescription extraction assistant. Output a JSON array only (camelCase keys), no markdown or commentary. Each array element is one prescription object with: prescriberName, institutionName, prescribedAt (yyyy-MM-dd), diagnosis, prescriptionNo, status, extra (object), medicationPlans (array). Even if only one prescription is found, output [{...}]. Output [] if none. Do NOT merge multiple prescriptions into one object. Do NOT output medicalCase. Each medicationPlans[] element MUST include medicineName and may include medicineType, brandName, dosageForm, strength, doseUnit, totalQuantity, expireDate, dosePerTime, doseValue, frequencyType (daily|every_n_days|weekly), everyNDays, weeklyWeekdays (integers 1-7), frequencyText, startDate, endDate, instructions, reminderEnabled, reminderTimes (array of objects {time: HH:mm, dose: number optional}, never plain strings), medicineBox (nested with medicineName, medicineType, brandName, dosageForm, strength, doseUnit, totalQuantity, expireDate, notes, extra), status, extra, sortOrder. Omit unknown/empty fields; never null or empty strings. Omit medicationPlans entirely if no drugs.\nOCR text:\n%@";
"ai.prompt.medication.extraction.template" = "You are a medication plan extraction assistant. Extract MedicineBox + MedicationPlan bundles from prescription, medication instruction, package, label, or OCR text. Return a JSON array only. Each item represents one medicine with its plan and may use camelCase keys only: medicineName, medicineType, brandName, drugName, dosageForm, strength, doseUnit, totalQuantity, expireDate, dosePerTime, doseValue, frequencyType, everyNDays, weeklyWeekdays, frequencyText, startDate, endDate, instructions, reminderEnabled, reminderTimes (array of objects {time: HH:mm, dose: number optional}, never plain strings), status, medicineBox, extra, sortOrder. medicineBox may include: medicineName, medicineType, brandName, dosageForm, strength, doseUnit, totalQuantity, expireDate, notes, extra. frequencyType must be daily, every_n_days, or weekly; use daily if unclear. Omit unknown fields, never output null. Use [] if no medication plan can be recognized. Return pure JSON only.\nOCR text:\n%@";
"ai.prompt.medicine_box.extraction.template" = "You are a medication box extraction assistant. Extract medicine box inventory items from medication package, bottle, blister, label, or instruction OCR text. Return a JSON array only. Each element uses camelCase keys exactly: medicineName, medicineType, brandName, dosageForm, strength, doseUnit, totalQuantity, expireDate, notes, extra, sortOrder. Rules: 1) Return multiple objects if multiple medicines are visible. 2) medicineName should use the clearest generic/trade display name. 3) medicineType is a category text such as cold/fever, digestive, cough/throat, chronic, pediatric, or a custom category. 4) strength is the package/specification text such as 0.5g x 24 tablets. 5) doseUnit is the per-dose unit text when visible (e.g. mg, g, tablet, sachet); empty string if unknown. 6) totalQuantity is package count text only when visible. 7) expireDate must be yyyy-MM-dd when visible. 8) Do not invent hidden quantity/date. 9) Use [] if no medicine can be recognized. 10) Return pure JSON only.\nOCR text:\n%@";
"ai.prompt.context.header" = "Recent medical context for member (latest %d records):";
"ai.prompt.context.line" = "- [%@] %@: %@";
"ai.prompt.fallback.assistant" = "I can't provide a valid response right now. Please try again shortly.";
"ai.prompt.thread.new_title" = "New Chat";
"ai.prompt.consent.blocked.default_reason" = "Sensitive information was not forwarded to the model.";
"ai.prompt.consent.blocked.template" = "[ConsentGate] %@";
"ai.prompt.medical_extraction.retry_correction.template" = "[Retry correction]\nThe previous structured extraction failed:\n- Document type: %@\n- Invalid field: %@\n- Expected type: %@\n- Previous actual type: %@\n- Error: %@\n- Fix suggestion: %@\n\nPlease return pure JSON that follows the original schema, without changing OCR facts.\nDo not return Markdown or explanatory text.\nUse schema-compatible empty values when unknown; for example, use {} for unknown extra and [] for unknown arrays.";
"ai.prompt.medical_extraction.retry.not_available" = "N/A";
"ai.prompt.medical_extraction.retry.kind.auto" = "auto";
"ai.prompt.medical_extraction.retry.kind.case_document" = "case document";
"ai.prompt.medical_extraction.retry.kind.health_exam_report" = "health exam report";
"ai.prompt.medical_extraction.retry.kind.medical_report" = "medical report";
"ai.prompt.medical_extraction.retry.kind.prescription" = "prescription";
"ai.prompt.medical_extraction.retry.kind.medication_plan" = "medication plan";
"ai.prompt.medical_extraction.retry.kind.medicine_box" = "medicine box";
"ai.prompt.medical_extraction.retry.suggestion.extra" = "`extra` must be a JSON object. Use `{}` when unknown. Do not use `\"\"`.";
"ai.prompt.medical_extraction.retry.suggestion.items" = "`items` must be an array. Use `[]` when no item is available.";
"ai.prompt.medical_extraction.retry.suggestion.medicines" = "`medicines` must be an array of medicine objects.";
"ai.prompt.medical_extraction.retry.suggestion.indicators" = "`indicators` must be an array of exam indicator objects.";
"ai.prompt.medical_extraction.retry.suggestion.sortOrder" = "Use integer number for `sortOrder`, not string.";
"ai.prompt.medical_extraction.retry.suggestion.date" = "Use `yyyy-MM-dd` when visible; otherwise use the schema-compatible empty value.";
"ai.prompt.medical_extraction.retry.suggestion.json_shape" = "Return pure JSON only. Do not wrap the payload in Markdown or prose.";
"ai.prompt.medical_extraction.retry.suggestion.generic_type" = "Match the schema field types exactly.";
"ai.prompt.medical_extraction.retry.suggestion.generic" = "Return JSON that matches the original schema and field types.";
"ai.prompt.medical_extraction.retry.suggestion.type_mismatch" = "Expected type %@ but got %@. Return schema-compatible JSON types.";
"ai.prompt.nutrition.food_description.template" = "You are a food photo description assistant. Describe visible foods, estimated portions, cooking methods, and ingredients in natural language for the user's language. Do not output JSON or markdown.\nMeal context: %@";
"ai.prompt.nutrition.intake_extraction.template" = "You are a nutrition intake extraction assistant. Return exactly one valid JSON object and nothing else.\nUse camelCase keys only: title, mealType, confidence, overview, items, intakes, uncertainNotes.\noverview must include energyKcal, proteinG, carbohydrateG, fatG.\nEach items[] element may include foodItemId (optional), name, servingRatio, servingDescription, confidence.\nEach intakes[] element must include nutrientType, value, unit, and optional confidence.\nuncertainNotes must be a string.\nDo not output null. If a numeric value is unknown, use 0 and explain the uncertainty in uncertainNotes.\nDo not invent precise values when uncertain; put doubts in uncertainNotes.\nDefault mealType when unclear: %@\n\nInput:\n%@";
"ai.prompt.nutrition.extraction.retry_correction.template" = "[Retry correction]\nThe previous nutrition extraction JSON failed to decode.\n- Error: %@\n- Previous output preview: %@\n\nReturn pure JSON only with camelCase keys. Do not use markdown, code fences, or explanatory text.";
"ai.prompt.nutrition.extraction.not_available" = "N/A";
