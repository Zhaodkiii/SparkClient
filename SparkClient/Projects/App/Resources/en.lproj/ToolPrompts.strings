"tool.summary.list_member_health_sources" = "Purpose: Search saved health sources from complete-data. Output JSON includes member_id and candidates — NOT full clinical text. Input: optional member_id, resource_types (preferred, multiple types) or resource_type (single, legacy), keyword, date range, limit. Rules: (1) member_id in output is authoritative for this turn — do NOT call request_member_selection or find_member afterward; (2) one candidate skips report confirmation UI; (3) multiple candidates show report picker; (4) then get_health_resource_context once with references. Use query_member_profile only for counts.";
"tool.summary.get_health_resource_reference" = "Purpose: Only when you must validate that a reference exists and you do not yet have resource_id (compact JSON + client reference card). After list or user confirmation, use get_health_resource_context for interpretation — do not call both tools on the same resource.";
"tool.summary.get_health_resource_context" = "Purpose: Build AI-readable interpretation context (same schema as client M8). Prefer batch: pass references JSON (from list or user-confirmed candidates) in ONE call; returns version=2 with contexts and combined_context_text. Single record may use resource_type+resource_id (version=1). When comparing multiple reports, MUST batch—do not call per resource. Do not call get_health_resource_reference for the same items. Never persist output to message database.";
"tool.param.health_resource_type_enum" = "Health source type: health_exam_report, examination_report, medical_case, prescription, medication_plan, medicine_box, medication_record, medication_summary, symptom, visit, surgery, follow_up";
"tool.param.health_resource_types_filter" = "Optional filter: array of health source types (e.g. health_exam_report, examination_report). JSON array or comma-separated; merges with resource_type; empty = all types.";
"tool.param.health_resource_id" = "Primary key of the resource in complete-data";
"tool.param.health_keyword" = "Search keyword for title, exam name, summary, findings";
"tool.param.health_sources_limit" = "Max candidates returned (default 20)";
"tool.param.health_topic_focus" = "Optional focus topic for context trimming, e.g. blood_pressure, thyroid";
"tool.param.health_references_json" = "Batch interpretation: JSON array of {resource_type, resource_id, member_id?}. Align with list/confirmed candidates, max 5. When set, call this tool once—do not repeat per resource. Single record may still use resource_type+resource_id.";
"tool.summary.ask_user_question" = "Purpose: flexibly ask the user to choose or clarify during an answer (not only generic Q&A). Primary use — pick report(s) to interpret: (1) when the user is vague (e.g. \"last checkup\", \"thyroid report\", \"recent endoscopy\"), call list_member_health_sources first, then ask_user_question with 2-5 options (single/multiple); option text = title · date · institution — never put resourceID in options; (2) when list returns 2-5 similar matches, let the user pick, then get_health_resource_reference + get_health_resource_context; (3) confirm member, date range, or focus (blood pressure, thyroid, etc.) before interpreting. Supports 2-5 options, single/multiple, allows_other. Do NOT replace list for full search; respect records the user already added via Ask Report UI. After submission, finish refs and interpretation.";
"tool.param.ask_user_question" = "A concise, clear question for the user.";
"tool.param.ask_user_questions" = "Question array, up to 5 items. Each item includes question, options, selection_mode, and allows_other.";
"tool.param.ask_user_question_item" = "A single question object.";
"tool.param.ask_user_options" = "2-5 options.";
"tool.param.ask_user_option_item" = "Option label.";
"tool.param.ask_user_selection_mode" = "single or multiple.";
"tool.param.ask_user_allows_other" = "Whether the user may enter another answer.";
