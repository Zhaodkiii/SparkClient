/* ToolPrompts — English（发给模型的文案） */
/* 键名：稳定英文 tool.*，与 ToolHub.swift 中 td("…") 一致；勿改键名，仅改右侧译文。 */
/* 维护：新增工具时在 en / zh-Hans / zh-Hant 三份中同步增加相同键。 */

/* ========== 工具 function 摘要（发给模型） ========== */
"tool.summary.fetch_step_details" = "Purpose: get hourly step counts with daily and overall totals. Trigger: user reviews activity or plans fitness. Input start_date/end_date ≤ today, yyyy‑MM‑dd. Unit: steps. Pair with: fetch_energy_details for holistic activity analysis.";
"tool.summary.fetch_energy_details" = "Purpose: hourly resting/active/total energy (kcal). Trigger: user checks calorie expenditure. Same date input rules as steps. Pair with: fetch_step_details, fetch_nutrition_details for burn‑intake comparison.";
"tool.summary.fetch_nutrition_details" = "Purpose: 3‑hour nutrition breakdown (protein, carbs, fat, kcal). Trigger: user reviews diet or plans meals. Same date input. Pair with: make_nutrition_data to create health card.";
"tool.summary.make_nutrition_data" = "Purpose: Generate nutrition cards from dietary info; values must be non‑negative (g/kcal). Trigger: recording or analyzing a meal. Can pair with fetch_nutrition_details.";
"tool.summary.fetch_sleep_details" = "Purpose: Retrieve sleep by session and daily summary (core/deep/REM/unspecified). Trigger: sleep quality review. Input start_date/end_date ≤ today, yyyy‑MM‑dd. Pair with: fetch_step_details, fetch_energy_details.";
"tool.summary.fetch_workout_details" = "Purpose: retrieve workout records. Input: start_date, end_date; optional types filter; max_items limit. Pair with: fetch_step_details, fetch_energy_details.";
"tool.summary.generate_structured_health_card" = "Purpose: Saveable structured health cards (async extraction). Pass report_type; raw_text must be distilled excerpt (not full OCR). Optional oss_file_id.";
"tool.summary.query_tasks_by_member" = "Purpose: query member-level existing tasks (main + subtype status) for dedup analysis before task generation. member_id is optional and defaults to current home member. Rule: call this before generate_task. Output should be structured JSON.";
"tool.summary.generate_task" = "Purpose: generate pending task-card JSON from user input, including async extraction and similarity checks. member_id is optional and defaults to current home member. Rule: query_tasks_by_member must run first. If similar tasks exist, return no-create JSON; otherwise return task_cards JSON.";
"tool.summary.search_knowledge_bag" = "Purpose: search user's private Knowledge Bag and return digest. Trigger: personal notes/docs. Input 'query' precisely describes topic. Use before search_online. Pair with: retrieve_memory.";
"tool.summary.create_knowledge_document" = "Usage: Generate a preview knowledge-card draft (do not persist immediately) when summarizing or on user request. title concise; content in Markdown with clear headings; user confirms save in the chat card.";
"tool.summary.search_calendar_and_reminders" = "Purpose: filter calendar events and reminders. Provide at least one of keyword, date range, or place. Dates yyyy‑MM‑dd in local TZ. Skip if all filters empty.";
"tool.summary.write_system_event" = "Purpose: add calendar event or reminder. Times ISO‑8601 with TZ. calendar: start_date and end_date; reminder: due_date. Put location for reminders in notes.";
"tool.summary.query_location" = "Purpose: place name to coordinates (WGS‑84) and static map. keyword: specific place or POI. Pair with: search_nearby_locations, get_current_location.";
"tool.summary.get_current_location" = "Purpose: current location. query fixed value \"local\". Pair with: search_nearby_locations, get_route, query_weather.";
"tool.summary.search_nearby_locations" = "Purpose: POIs near coordinate matching keyword. coordinate with lat/lon; keyword e.g. café. Pair with: query_location.";
"tool.summary.get_route" = "Purpose: plan driving/walking/transit route. Input start & end coords and mode. Pair with: query_location, get_current_location.";
"tool.summary.query_weather" = "Purpose: weather at coords; now or multi‑day (3d/7d/10d/15d/30d). Inputs: latitude, longitude, timeRange.";
"tool.summary.save_memory" = "Purpose: store long‑term memory. content concise (prefer S‑V‑O). Avoid duplicates. Pair with: retrieve_memory.";
"tool.summary.retrieve_memory" = "Purpose: fetch long‑term memory. keyword may use semicolons. Call only when needed. Pair with: save_memory.";
"tool.summary.update_memory" = "Purpose: update memory. originalContent and updatedContent; exact match only. Use with retrieve_memory.";
"tool.summary.generate_chat_title" = "Purpose: concise chat title (≤6 chars, emoji allowed). No required parameters.";
"tool.summary.show_custom_message_card" = "Purpose: Show capture/upload card in reply when attachments are missing for report/meds/skin.";
"tool.summary.get_current_member" = "Purpose: Read currently selected member basics. Spark returns a prompt if none selected.";
"tool.summary.switch_member" = "Purpose: Switch member; subsequent tools use new selection (Spark placeholder).";
"tool.summary.find_member" = "Purpose: Find member by relationship and/or name (partial). Provide at least one.";
"tool.summary.query_member_profile" = "Purpose: Query member health profile by query_type. Optional member_id (UUID string in Spark); optional days, limit. Spark returns aggregate counts.";
"tool.summary.search_online" = "Purpose: web search and summarise. query concise; no sensitive PII. Pair with: read_web_page, search_knowledge_bag.";
"tool.summary.read_web_page" = "Purpose: fetch page content/summary. url full HTTP(S). Parse each link once.";
"tool.summary.search_arxiv_papers" = "Purpose: arXiv search and summaries. query: English topic keywords.";
"tool.summary.extract_remote_file_content" = "Purpose: extract text from remote files. url: full HTTP(S) file link.";
"tool.summary.create_canvas" = "Usage: Create canvas for long text/code/HTML. Requires title, content, type (text|python|html).";
"tool.summary.edit_canvas" = "Usage: Edit canvas via regex patterns/replacements pairs. For large rewrites prefer create_canvas.";
"tool.summary.generic" = "Execute tool %@.";
